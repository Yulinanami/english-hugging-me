<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Card?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            styleClass="settings-scroll">
    <content>
        <VBox spacing="10.0" styleClass="settings-page">
            <children>
                <Card maxWidth="Infinity" styleClass="settings-card">
                    <header>
                        <Label text="词汇本" styleClass="settings-card-title" />
                    </header>
                    <body>
                        <GridPane hgap="8.0" vgap="8.0">
                            <children>
                                <Label text="词汇本：" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <ComboBox fx:id="vocabularyChoice" prefWidth="300.0" />
                                        <Button text="导入" styleClass="accent" onAction="#importVocabulary" />
                                    </children>
                                </HBox>
                                <Button text="重新加载"
                                        onAction="#reloadVocabulary"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </body>
                </Card>
            </children>
        </VBox>
    </content>
</ScrollPane>
