<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/page_header_top_padding"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/backIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/icon_back"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/custom_vocabulary"
            style="@style/Ehm.HeaderTitle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_content_top_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/page_content_bottom_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customWordInput"
                        android:text="@string/word_label"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/required"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customWordInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customTypeInput"
                        android:text="@string/part_of_speech"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/part_of_speech_summary"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customTypeInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customMeaningInput"
                        android:text="@string/meaning"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/meaning_summary"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customMeaningInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customPhraseInput"
                        android:text="@string/phrase"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/optional"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customPhraseInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customPhraseMeaningInput"
                        android:text="@string/phrase_meaning"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/phrase_meaning_summary"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customPhraseMeaningInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/customExampleInput"
                        android:text="@string/example_sentence"
                        style="@style/Ehm.ItemTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/optional"
                        style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/customExampleInput"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/Ehm.SecondaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/save_word" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/added_vocabulary"
                style="@style/Ehm.SectionLabel" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/no_custom_vocabulary"
                style="@style/Ehm.BodyText" />

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
