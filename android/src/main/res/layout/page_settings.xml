<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/page_header_top_padding"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/backIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/icon_back"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings"
            style="@style/Ehm.HeaderTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_content_top_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/page_content_bottom_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/basic_settings"
                style="@style/Ehm.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vocabulary_book" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vocabulary_setting_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/vocabularyDropdown"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/display_content" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/display_content_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/displayModeDropdown"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playback_order" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playback_order_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/playbackModeDropdown"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overlay_behavior" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overlay_behavior_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/overlayModeDropdown"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/intervalSeconds" android:text="@string/switch_interval" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seconds_unit" style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/intervalSeconds"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/opacity" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/opacity_summary" style="@style/Ehm.ItemSubtitle" />
                    <SeekBar
                        android:id="@+id/opacitySeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="80" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/prefix_playback"
                style="@style/Ehm.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/starting_prefix" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/starting_prefix_summary" style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/startingPrefix"
                        style="@style/Ehm.Input"
                        android:hint="@string/starting_prefix_hint"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loop_playback" style="@style/Ehm.ItemTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loop_playback_summary" style="@style/Ehm.ItemSubtitle" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/loopPlaybackSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/appearance"
                style="@style/Ehm.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/word_color" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/word_color_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/wordColor"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/type_color" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/type_color_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/typeColor"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/translation_color" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/translation_color_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/translationColor"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/phrase_color" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/phrase_color_summary" style="@style/Ehm.ItemSubtitle" />
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/phraseColor"
                        style="@style/Ehm.Dropdown" />
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/word_font_size" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/word_font_size_summary" style="@style/Ehm.ItemSubtitle" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wordFontMinus"
                            style="@style/Ehm.StepperButton"
                            android:text="@string/symbol_minus" />
                        <EditText
                            android:id="@+id/wordFontSize"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_stepper_input"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:padding="4dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wordFontPlus"
                            style="@style/Ehm.StepperButton"
                            android:text="@string/symbol_plus" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/detail_font_size" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/detail_font_size_summary" style="@style/Ehm.ItemSubtitle" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/detailFontMinus"
                            style="@style/Ehm.StepperButton"
                            android:text="@string/symbol_minus" />
                        <EditText
                            android:id="@+id/detailFontSize"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_stepper_input"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:padding="4dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/detailFontPlus"
                            style="@style/Ehm.StepperButton"
                            android:text="@string/symbol_plus" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_size" style="@style/Ehm.ItemTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_size_summary" style="@style/Ehm.ItemSubtitle" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/autoSizeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resize_overlay" style="@style/Ehm.ItemTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resize_overlay_summary" style="@style/Ehm.ItemSubtitle" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/resizeModeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/fill_blank_settings"
                style="@style/Ehm.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout style="@style/Ehm.SettingItem">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_interval" style="@style/Ehm.ItemTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_interval_summary" style="@style/Ehm.ItemSubtitle" />
                    <EditText
                        android:id="@+id/fillBlankInterval"
                        style="@style/Ehm.Input"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_hide_phrases" style="@style/Ehm.ItemTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_hide_phrases_summary" style="@style/Ehm.ItemSubtitle" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/fillBlankHidePhrasesSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_show_translation" style="@style/Ehm.ItemTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fill_blank_show_translation_summary" style="@style/Ehm.ItemSubtitle" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/fillBlankShowTranslationSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
